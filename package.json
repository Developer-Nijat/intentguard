  "type": "module",
  "license": "MIT",
  "author": "Developer-Nijat",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Developer-Nijat/intentguard.git"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "architecture-decision-records",
    "adr",
    "constraints",
    "ai-agents"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "intentguard": "bin/intentguard.js"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    ".claude-plugin",
    "agents",
    "bin",
    "commands",
    "hooks",
